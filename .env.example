# Turso backend (required for Admin + persistent data)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN
PORT=8787
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Local admin bootstrap account
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# AI assistant and translation tools (optional)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_PROVIDER=auto

# Local browser-side CMS translation fallback (optional)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:7b
# VITE_OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY

# Server-side CMS translation route (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY
