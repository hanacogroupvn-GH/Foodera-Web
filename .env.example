# Supabase (required for Admin + persistent data)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_SUPABASE_PDF_BUCKET=product-pdfs
VITE_SUPABASE_IMAGE_BUCKET=cms-images

# AI assistant (optional)
VITE_GEMINI_API_KEY=PLACEHOLDER_API_KEY

# Local browser-side CMS translation fallback (optional)
# For shared production use, prefer the Supabase Edge Function secrets:
# OLLAMA_BASE_URL / OLLAMA_MODEL / OLLAMA_API_KEY
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=qwen2.5:7b
# VITE_OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY

# Local dev server CMS translation fallback (optional)
# Used automatically by `npm run dev` before the browser-side fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY
