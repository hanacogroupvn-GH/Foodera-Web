# Database mode
# auto  = use Turso when configured, otherwise use a local SQLite file in local Node development
# turso = require Turso credentials
# local = force a local SQLite file (recommended for local-only development)
# `.env.local` can override these values on a developer machine without changing official config.
DATABASE_MODE=auto
LOCAL_DATABASE_PATH=tmp/foodmax-local.db

# Turso backend (required in production / serverless)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN
PORT=8787
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Local admin bootstrap account
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# Map Content AI-suggest (optional) — used by /admin/interactive-map's
# AI-drafting-assist feature. Gemini is tried first, falling back to Ollama.
AI_PROVIDER=auto
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY

# Set to true to allow local SQLite without DATABASE_MODE=local
# ALLOW_LOCAL_DATABASE=false

# NODE_ENV controls secure cookie flag (set to 'production' in prod)
# NODE_ENV=production
